{
  "name": "Drone Web Controller",
  "version": "1.0.0",
  "description": "FastAPI WebSocket interface for drone MAVLink telemetry and control",
  "company": "Drone School",
  "type": "device-integration",
  "repository": "https://github.com/comy33/drone-web-app",
  "docker": {
    "image": "comy33/drone-web-app:latest",
    "binds": [],
    "privileged": false,
    "network": "bridge",
    "ports": [
      {
        "containerPort": 9999,
        "hostPort": 9999,
        "type": "tcp"
      }
    ],
    "environment": [
      {
        "name": "MAV_ENDPOINT",
        "value": "udpout:host.docker.internal:14550"
      }
    ]
  }
}
